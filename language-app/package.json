{
  "name": "polyglot-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env tools/dev-api.ts & vite",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env tools/dev-api.ts",
    "build": "node scripts/build-gas.mjs --check && tsc -b && vite build",
    "build:gas": "node scripts/build-gas.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
